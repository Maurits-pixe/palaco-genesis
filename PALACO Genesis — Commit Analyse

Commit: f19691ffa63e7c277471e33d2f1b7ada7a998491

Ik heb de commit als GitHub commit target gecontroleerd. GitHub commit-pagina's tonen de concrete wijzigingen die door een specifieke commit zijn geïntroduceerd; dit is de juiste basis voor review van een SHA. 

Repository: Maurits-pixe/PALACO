3. Gateway Router & Pipeline Integration
// crates/palaco-gateway/src/router.rs

use crate::request::IncomingRequest;
use palaco_quay::{QuayEngine, QuayRecord, Provenance, EvidenceBundle, EvidenceArtifact, EvidenceType, ReplayRegistry, QuayResult};
use palaco_vault::{VaultStore, VaultError};
use palaco_kernel::{EventBus, KernelEvent};

/// Errors produced during gateway routing and processing.
#[derive(Debug, Clone, PartialEq, Eq)]
pub enum GatewayError {
    /// Vault commit failed during persistence.
    VaultCommitFailed(VaultError),
    /// Record was quarantined at the Quay boundary.
    QuarantinedByQuay,
}

/// The central gateway router orchestrating ingress, Quay verification, and Vault storage.
pub struct GatewayRouter {
    replay_registry: ReplayRegistry,
    vault: VaultStore,
    event_bus: EventBus,
}

impl GatewayRouter {
    /// Creates a new gateway router instance.
    pub fn new() -> Self {
        Self {
            replay_registry: ReplayRegistry::new(),
            vault: VaultStore::new(),
            event_bus: EventBus::new(),
        }
    }

    /// Routes an incoming request through Quay validation, Vault persistence, and Event broadcasting.
    pub fn route(&mut self, request: IncomingRequest) -> Result<(), GatewayError> {
        let record_id = request.record_id().clone();
        let source_id = request.context().source_id().clone();
        let payload = request.payload().to_vec();
        let timestamp = request.context().timestamp_nanos();

        // 1. Build primitive QuayRecord and Genesis Provenance
        let quay_record = QuayRecord::new(record_id.clone(), payload, source_id.clone());
        let provenance = Provenance::genesis(record_id.clone(), source_id);

        // 2. Construct default bootstrap evidence artifact for the gateway ingress
        let artifact = EvidenceArtifact::new(EvidenceType::InvariantValidation, vec![1, 0, 1]);
        let evidence = EvidenceBundle::new(
            record_id.clone(),
            quay_record.payload_digest().clone(),
            provenance.clone(),
            vec![artifact],
        );

        // 3. Process through Quay Engine with Replay Protection
        let quay_result = QuayEngine::process_with_replay(
            &mut self.replay_registry,
            quay_record,
            provenance,
            evidence,
            timestamp,
        );

        // 4. Handle Result (Accept -> Vault + Event | Quarantine -> Event)
        match quay_result {
            QuayResult::Accepted(proven_record) => {
                self.vault.commit(proven_record)
                    .map_err(GatewayError::VaultCommitFailed)?;
                
                self.event_bus.publish(&KernelEvent::RecordProven(record_id));
                Ok(())
            }
            QuayResult::Quarantined(_) => {
                self.event_bus.publish(&KernelEvent::RecordQuarantined(record_id));
                Err(GatewayError::QuarantinedByQuay)
            }
        }
    }

    /// Returns a reference to the underlying vault store.
    pub fn vault(&self) -> &VaultStore {
        &self.vault
    }

    /// Returns a mutable reference to the kernel event bus.
    pub fn event_bus_mut(&mut self) -> &mut EventBus {
        &mut self.event_bus
    }
}

