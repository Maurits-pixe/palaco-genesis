De scheduler zorgt ervoor dat alle interne taken (inclusief telemetrie, quarantaine-audits en background maintenance) in een deterministische volgorde worden uitgevoerd.
// crates/palaco-kernel/src/scheduler.rs

use std::collections::VecDeque;

/// Unique identifier for a scheduled kernel task.
#[derive(Debug, Clone, PartialEq, Eq, Hash)]
pub struct TaskId(pub u64);

/// Execution priority levels within the Citadel.
#[derive(Debug, Clone, Copy, PartialEq, Eq, PartialOrd, Ord)]
pub enum TaskPriority {
    /// Critical safety or system recovery tasks.
    Critical = 0,
    /// Standard telemetry and workflow transitions.
    Normal = 1,
    /// Background maintenance and audits.
    Background = 2,
}

/// A discrete unit of work executed by the kernel runtime.
pub struct Task {
    id: TaskId,
    priority: TaskPriority,
    payload: Box<dyn FnOnce() -> Result<(), &'static str> + Send>,
}

impl Task {
    /// Creates a new executable task.
    pub fn new(
        id: TaskId,
        priority: TaskPriority,
        payload: impl FnOnce() -> Result<(), &'static str> + Send + 'static,
    ) -> Self {
        Self {
            id,
            priority,
            payload: Box::new(payload),
        }
    }

    /// Returns the task identifier.
    pub fn id(&self) -> &TaskId {
        &self.id
    }

    /// Returns the execution priority.
    pub fn priority(&self) -> TaskPriority {
        self.priority
    }

    /// Executes the task payload.
    pub fn execute(self) -> Result<(), &'static str> {
        (self.payload)()
    }
}

/// Deterministic priority-based task queue.
#[derive(Default)]
pub struct Scheduler {
    critical_queue: VecDeque<Task>,
    normal_queue: VecDeque<Task>,
    background_queue: VecDeque<Task>,
}

impl Scheduler {
    /// Creates a new scheduler instance.
    pub fn new() -> Self {
        Self::default()
    }

    /// Enqueues a task according to its priority.
    pub fn schedule(&mut self, task: Task) {
        match task.priority() {
            TaskPriority::Critical => self.critical_queue.push_back(task),
            TaskPriority::Normal => self.normal_queue.push_back(task),
            TaskPriority::Background => self.background_queue.push_back(task),
        }
    }

    /// Pulls the next highest-priority task from the queues.
    pub fn next_task(&mut self) -> Option<Task> {
        if let Some(task) = self.critical_queue.pop_front() {
            return Some(task);
        }
        if let Some(task) = self.normal_queue.pop_front() {
            return Some(task);
        }
        self.background_queue.pop_front()
    }
}

