/// A monotonically increasing counter for discrete events (e.g., accepted records, failures).
#[derive(Debug, Default, Clone, Copy, PartialEq, Eq)]
pub struct MetricCounter(pub u64);

impl MetricCounter {
    /// Increments the counter by one.
    pub fn increment(&mut self) {
        self.0 += 1;
    }

    /// Returns the current count value.
    pub fn value(&self) -> u64 {
        self.0
    }
}

/// A point-in-time value gauge (e.g., queue depths, memory or active tasks).
#[derive(Debug, Default, Clone, Copy, PartialEq, Eq)]
pub struct MetricGauge(pub i64);

impl MetricGauge {
    /// Sets the gauge to a specific value.
    pub fn set(&mut self, val: i64) {
        self.0 = val;
    }

    /// Returns the current gauge value.
    pub fn value(&self) -> i64 {
        self.0
    }
}

/// Consolidated system metrics snapshot for the Observatory console.
#[derive(Debug, Default, Clone, Copy, PartialEq, Eq)]
pub struct SystemMetrics {
    records_accepted: MetricCounter,
    records_quarantined: MetricCounter,
    active_tasks: MetricGauge,
    quarantine_depth: MetricGauge,
}

impl SystemMetrics {
    /// Creates a new metrics snapshot container.
    pub fn new() -> Self {
        Self::default()
    }

    /// Returns accepted records counter.
    pub fn accepted(&self) -> &MetricCounter {
        &self.records_accepted
    }

    /// Returns quarantined records counter.
    pub fn quarantined(&self) -> &MetricCounter {
        &self.records_quarantined
    }

    /// Increments accepted records count.
    pub fn bump_accepted(&mut self) {
        self.records_accepted.increment();
    }

    /// Increments quarantined records count.
    pub fn bump_quarantined(&mut self) {
        self.records_quarantined.increment();
        self.quarantine_depth.set(self.records_quarantined.value() as i64);
    }
}

