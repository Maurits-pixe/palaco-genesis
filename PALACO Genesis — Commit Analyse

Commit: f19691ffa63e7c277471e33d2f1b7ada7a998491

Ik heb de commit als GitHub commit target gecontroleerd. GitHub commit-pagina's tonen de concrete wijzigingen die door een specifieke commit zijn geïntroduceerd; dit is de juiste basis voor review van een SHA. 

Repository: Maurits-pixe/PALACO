/// Simple publish-subscribe kernel event bus.
#[derive(Default)]
pub struct EventBus {
    subscribers: Vec<Box<dyn Fn(&KernelEvent) + Send + Sync>>,
}

impl EventBus {
    /// Creates a new event bus.
    pub fn new() -> Self {
        Self::default()
    }

    /// Registers an event subscriber callback.
    pub fn subscribe(&mut self, subscriber: impl Fn(&KernelEvent) + Send + Sync + 'static) {
        self.subscribers.push(Box::new(subscriber));
    }

    /// Publishes an event to all registered subscribers.
    pub fn publish(&self, event: &KernelEvent) {
        for sub in &self.subscribers {
            sub(event);
        }
    }
}

