    /// Critical failure requiring isolation or restart.
    Failed,
}

/// Actions taken by the supervisor to heal the runtime.
#[derive(Debug, Clone, Copy, PartialEq, Eq)]
pub enum SupervisorAction {
    /// No action required.
    None,
    /// Isolate the failing component via circuit breaker.
    IsolateComponent,
    /// Trigger a full kernel lockdown / safe mode.
    TriggerSystemLockdown,
}

/// Supervisor engine monitoring subsystem vitality.
pub struct SupervisedSubsystem {
    name: &'static str,
    health: SubsystemHealth,
    circuit_breaker: CircuitBreaker,
}

impl SupervisedSubsystem {
    /// Creates a new supervised subsystem instance.
    pub fn new(name: &'static str, failure_threshold: u32) -> Self {
        Self {
            name,
            health: SubsystemHealth::Healthy,
            circuit_breaker: CircuitBreaker::new(failure_threshold),
        }
    }

    /// Evaluates an error event and determines the required healing action.
    pub fn handle_error(&mut self) -> SupervisorAction {
        self.circuit_breaker.record_failure();
        
        if !self.circuit_breaker.allow_execution() {
            self.health = SubsystemHealth::Failed;
            return SupervisorAction::IsolateComponent;
        }

        self.health = SubsystemHealth::Degraded;
        SupervisorAction::None
    }

    /// Returns the subsystem identifier.
    pub fn name(&self) -> &'static str {
        self.name
    }

    /// Returns the current health state.
    pub fn health(&self) -> SubsystemHealth {
        self.health
    }
}

