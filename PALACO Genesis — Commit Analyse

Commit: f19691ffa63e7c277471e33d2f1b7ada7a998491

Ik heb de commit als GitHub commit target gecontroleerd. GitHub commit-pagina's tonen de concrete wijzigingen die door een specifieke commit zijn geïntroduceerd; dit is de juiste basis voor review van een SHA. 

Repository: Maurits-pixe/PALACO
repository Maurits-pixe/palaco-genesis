// crates/palaco-cli/src/commands.rs

use palaco_gateway::{GatewayRouter, IncomingRequest, RequestContext};
use palaco_quay::{RecordId, SourceId};

/// Supported operator commands within the Citadel CLI.
#[derive(Debug, Clone, PartialEq, Eq)]
pub enum CliCommand {
    /// Submits a new raw payload into the secure gateway.
    SubmitRecord {
        record_id: String,
        payload: Vec<u8>,
        source_id: String,
    },
    /// Inspects the current health and vault record count.
    InspectSystem,
    /// Requests a system lockdown or emergency halt.
    EmergencyLockdown,
}

/// Outcome of executing a CLI command.
#[derive(Debug, Clone, PartialEq, Eq)]
pub enum CommandResult {
    /// Record successfully processed and stored.
    Success(&'static str),
    /// System inspection data snapshot.
    SystemStatus {
        vault_records_count: usize,
    },
    /// Emergency lockdown initiated.
    LockedDown,
    /// Command execution failed.
    Failure(&'static str),
}

/// Executes Citadel commands against the gateway and kernel routers.
pub struct CommandDispatcher;

impl CommandDispatcher {
    /// Dispatches a CLI command to the appropriate subsystem.
    pub fn dispatch(router: &mut GatewayRouter, command: CliCommand, timestamp_nanos: u64) -> CommandResult {
        match command {
            CliCommand::SubmitRecord { record_id, payload, source_id } => {
                let context = RequestContext::new(SourceId(source_id), "CLI", timestamp_nanos);
                let request = IncomingRequest::new(RecordId(record_id), payload, context);

                match router.route(request) {
                    Ok(_) => CommandResult::Success("Record proven, vaulted, and broadcasted."),
                    Err(_) => CommandResult::Failure("Record rejected or quarantined by Quay boundary."),
                }
            }
            CliCommand::InspectSystem => {
                let count = router.vault().len();
                CommandResult::SystemStatus {
                    vault_records_count: count,
                }
            }
            CliCommand::EmergencyLockdown => {
                CommandResult::LockedDown
            }
        }
    }
}

