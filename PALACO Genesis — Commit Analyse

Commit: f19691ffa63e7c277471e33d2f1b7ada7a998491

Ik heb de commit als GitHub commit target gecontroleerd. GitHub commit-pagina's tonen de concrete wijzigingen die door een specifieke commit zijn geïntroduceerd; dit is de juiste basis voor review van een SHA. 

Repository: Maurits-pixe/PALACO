2. Circuit Breaker Pattern voor Subsystemen
Om cascade-fouten te voorkomen als een extern of intern onderdeel instort, implementeren we een strikte circuit breaker met automatische fail-closed isolatie.
// crates/palaco-resilience/src/circuit_breaker.rs

/// Operational states of a circuit-protected subsystem.
#[derive(Debug, Clone, Copy, PartialEq, Eq)]
pub enum CircuitState {
    /// Normal operation; requests and transactions flow freely.
    Closed,
    /// Failure threshold reached; requests are blocked/isolated.
    Open,
    /// Testing recovery; limited probe traffic allowed.
    HalfOpen,
}

/// A deterministic circuit breaker ensuring fault containment.
pub struct CircuitBreaker {
    state: CircuitState,
    failure_count: u32,
    failure_threshold: u32,
}

impl CircuitBreaker {
    /// Creates a new circuit breaker with a specified failure threshold.
    pub fn new(failure_threshold: u32) -> Self {
        Self {
            state: CircuitState::Closed,
            failure_count: 0,
            failure_threshold,
        }
    }

    /// Returns the current state of the circuit.
    pub fn state(&self) -> CircuitState {
        self.state
    }

    /// Records a success, potentially resetting failure counts or closing the circuit.
    pub fn record_success(&mut self) {
        self.failure_count = 0;
        self.state = CircuitState::Closed;
    }

    /// Records a failure, tripping the breaker if the threshold is breached.
    pub fn record_failure(&mut self) {
        self.failure_count += 1;
        if self.failure_count >= self.failure_threshold {
            self.state = CircuitState::Open;
        }
    }

    /// Checks if execution is permitted through the breaker boundary.
    pub fn allow_execution(&self) -> bool {
        match self.state {
            CircuitState::Closed | CircuitState::HalfOpen => true,
            CircuitState::Open => false,
        }
    }
}

