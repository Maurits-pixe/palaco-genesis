use palaco_quay::{ProvenQuayRecord, RecordId};
use std::collections::HashMap;

/// Errors produced during vault persistence operations.
#[derive(Debug, Clone, PartialEq, Eq)]
pub enum VaultError {
    /// The record identifier already exists in the vault.
    RecordAlreadyExists(RecordId),
    /// The requested record could not be found.
    RecordNotFound(RecordId),
    /// Storage corruption or invariant breach detected.
    StorageIntegrityBreach(&'static str),
}

/// An immutable, append-only persistence store for proven records.
#[derive(Default)]
pub struct VaultStore {
    records: HashMap<RecordId, ProvenQuayRecord>,
}

impl VaultStore {
    /// Creates a new empty vault store.
    pub fn new() -> Self {
        Self {
            records: HashMap::new(),
        }
    }

    /// Commits a proven record into the immutable vault.
    pub fn commit(&mut self, proven_record: ProvenQuayRecord) -> Result<(), VaultError> {
        let id = proven_record.record().id().clone();
        if self.records.contains_key(&id) {
            return Err(VaultError::RecordAlreadyExists(id));
        }
        self.records.insert(id, proven_record);
        Ok(())
    }

    /// Retrieves a reference to a proven record by its identifier.
    pub fn get(&self, id: &RecordId) -> Result<&ProvenQuayRecord, VaultError> {
        self.records.get(id).ok_or_else(|| VaultError::RecordNotFound(id.clone()))
    }

    /// Returns the total number of securely stored proven records.
    pub fn len(&self) -> usize {
        self.records.len()
    }

    /// Returns true if the vault contains no records.
    pub fn is_empty(&self) -> bool {
        self.records.is_empty()
    }
}

