2. Task Scheduler & Determinisme
De scheduler zorgt ervoor dat alle interne taken (inclusief telemetrie, quarantaine-audits en background maintenance) in een deterministische volgorde worden uitgevoerd.
// crates/palaco-kernel/src/scheduler.rs

use std::collections::VecDeque;

/// Unique identifier for a scheduled kernel task.
#[derive(Debug, Clone, PartialEq, Eq, Hash)]
pub struct TaskId(pub u64);

/// Execution priority levels within the Citadel.
#[derive(Debug, Clone, Copy, PartialEq, Eq, PartialOrd, Ord)]
pub enum TaskPriority {
    /// Critical safety or system recovery tasks.
    Critical = 0,
    /// Standard telemetry and workflow transitions.
    Normal = 1,
    /// Background maintenance and audits.
    Background = 2,
}

/// A discrete unit of work executed by the kernel runtime.
pub struct Task {
    id: TaskId,
    priority: TaskPriority,
    payload: Box<dyn FnOnce() -> Result<(), &'static str> + Send>,
}

impl Task {
    /// Creates a new executable task.
    pub fn new(
        id: TaskId,
        priority: TaskPriority,
        payload: impl FnOnce() -> Result<(), &'static str> + Send + 'static,
    ) -> Self {
        Self {
            id,
            priority,
            payload: Box::new(payload),
        }
    }

    /// Returns the task identifier.
    pub fn id(&self) -> &TaskId {
        &self.id
    }

    /// Returns the execution priority.
    pub fn priority(&self) -> TaskPriority {
        self.priority
    }

    /// Executes the task payload.
    pub fn execute(self) -> Result<(), &'static str> {
        (self.payload)()
    }
}

/// Deterministic priority-based task queue.
#[derive(Default)]
pub struct Scheduler {
    critical_queue: VecDeque<Task>,
    normal_queue: VecDeque<Task>,
    background_queue: VecDeque<Task>,
}

impl Scheduler {
    /// Creates a new scheduler instance.
    pub fn new() -> Self {
        Self::default()
    }

    /// Enqueues a task according to its priority.
    pub fn schedule(&mut self, task: Task) {
        match task.priority() {
            TaskPriority::Critical => self.critical_queue.push_back(task),
            TaskPriority::Normal => self.normal_queue.push_back(task),
            TaskPriority::Background => self.background_queue.push_back(task),
        }
    }

    /// Pulls the next highest-priority task from the queues.
    pub fn next_task(&mut self) -> Option<Task> {
        if let Some(task) = self.critical_queue.pop_front() {
            return Some(task);
        }
        if let Some(task) = self.normal_queue.pop_front() {
            return Some(task);
        }
        self.background_queue.pop_front()
    }
}

3. Event Bus & Lifecycle Manager
Om subsystemen (zoals The Quay en het Observatorium)loos te koppelen, introduceren we een deterministische event-bus en state-machine voor de lifecycle.
// crates/palaco-kernel/src/event_bus.rs

use palaco_quay::RecordId;

/// System-wide events broadcasted across the Citadel kernel.
#[derive(Debug, Clone, PartialEq, Eq)]
pub enum KernelEvent {
    /// A record was successfully accepted and sealed by The Quay.
    RecordProven(RecordId),
    /// A record breached verification and entered quarantine.
    RecordQuarantined(RecordId),
    /// System health or telemetry anomaly detected.
    AnomalyDetected(&'static str),
}

/// Simple publish-subscribe kernel event bus.
#[derive(Default)]
pub struct EventBus {
    subscribers: Vec<Box<dyn Fn(&KernelEvent) + Send + Sync>>,
}

impl EventBus {
    /// Creates a new event bus.
    pub fn new() -> Self {
        Self::default()
    }

    /// Registers an event subscriber callback.
    pub fn subscribe(&mut self, subscriber: impl Fn(&KernelEvent) + Send + Sync + 'static) {
        self.subscribers.push(Box::new(subscriber));
    }

    /// Publishes an event to all registered subscribers.
    pub fn publish(&self, event: &KernelEvent) {
        for sub in &self.subscribers {
            sub(event);
        }
    }
}

// crates/palaco-kernel/src/lifecycle.rs

/// Operational states of the Citadel runtime.
#[derive(Debug, Clone, Copy, PartialEq, Eq)]
pub enum LifecycleState {
    /// Kernel booting and initializing sub-modules.
    Booting,
    /// Fully operational and ready for transactions/records.
    Active,
    /// Graceful shutdown or fault-isolation lockdown mode.
    DegradedOrLocked,
}

/// Manages the high-level system state of the Citadel.
pub struct SystemLifecycleManager {
    state: LifecycleState,
}

impl SystemLifecycleManager {
    /// Initializes the lifecycle manager in Booting state.
    pub fn new() -> Self {
        Self {
            state: LifecycleState::Booting,
        }
    }

    /// Transitions the system to active operational state.
    pub fn activate(&mut self) {
        self.state = LifecycleState::Active;
    }

    /// Forces a lockdown or degraded mode upon critical failures.
    pub fn lock_down(&mut self) {
        self.state = LifecycleState::DegradedOrLocked;
    }

    /// Returns the current lifecycle state.
    pub fn state(&self) -> LifecycleState {
        self.state
    }
}

