use sha2::{Sha256, Digest};

/// Unique cryptographic identifier for a Citadel mesh node.
#[derive(Debug, Clone, PartialEq, Eq, Hash)]
pub struct NodeId(pub String);

impl NodeId {
    /// Generates a node identifier from a public key or seed.
    pub fn derive(seed: &[u8]) -> Self {
        let mut hasher = Sha256::new();
        hasher.update(seed);
        let result = hasher.finalize();
        Self(format!("node-{:x}", result))
    }

    /// Returns the string representation.
    pub fn as_str(&self) -> &str {
        &self.0
    }
}

/// Operational state of a peer node within the mesh.
#[derive(Debug, Clone, Copy, PartialEq, Eq)]
pub enum PeerState {
    /// Peer is fully synchronized and verified.
    Synced,
    /// Peer is lagging or undergoing synchronization.
    Syncing,
    /// Peer failed validation or dropped offline.
    Isolated,
}

/// Representation of a peer node in the Citadel mesh.
pub struct MeshNode {
    id: NodeId,
    endpoint: String,
    state: PeerState,
}

impl MeshNode {
    /// Creates a new mesh peer record.
    pub fn new(id: NodeId, endpoint: impl Into<String>) -> Self {
        Self {
            id,
            endpoint: endpoint.into(),
            state: PeerState::Syncing,
        }
    }

    /// Returns the node identifier.
    pub fn id(&self) -> &NodeId {
        &self.id
    }

    /// Updates the synchronization state.
    pub fn set_state(&mut self, state: PeerState) {
        self.state = state;
    }

    /// Returns the current peer state.
    pub fn state(&self) -> PeerState {
        self.state
    }
}

