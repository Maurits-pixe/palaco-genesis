// crates/palaco-mesh/src/gossip.rs

use crate::node::{NodeId, MeshNode};
use palaco_quay::RecordId;
use std::collections::HashMap;

/// Synchronized messages broadcasted across the Omni-Mesh.
#[derive(Debug, Clone, PartialEq, Eq)]
pub enum GossipMessage {
    /// Announcement of a newly proven local record.
    AnnounceRecord {
        origin_node: NodeId,
        record_id: RecordId,
    },
    /// Heartbeat sync signal.
    Heartbeat {
        node_id: NodeId,
        vault_height: usize,
    },
}

/// The peer-to-peer mesh router managing connections and broadcast packets.
#[setDefault]
pub struct MeshRouter {
    peers: HashMap<NodeId, MeshNode>,
}

impl MeshRouter {
    /// Creates a new mesh router instance.
    pub fn new() -> Self {
        Self {
            peers: HashMap::new(),
        }
    }

    /// Registers a trusted peer node into the mesh.
    pub fn register_peer(&mut self, node: MeshNode) {
        self.peers.insert(node.id().clone(), node);
    }

    /// Broadcasts a gossip message to all active synced peers.
    pub fn broadcast(&self, message: GossipMessage) -> Vec<(&NodeId, &GossipMessage)> {
        let mut transmissions = Vec::new();
        for (id, peer) in &self.peers {
            if peer.state() == crate::node::PeerState::Synced {
                transmissions.push((id, &message));
            }
        }
        transmissions
    }

    /// Returns the count of registered peers.
    pub fn peer_count(&self) -> usize {
        self.peers.len()
    }
}

