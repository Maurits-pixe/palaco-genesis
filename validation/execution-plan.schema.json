{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PVC-001 ExecutionPlan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "source_revision",
    "system_graph_sha256",
    "planner",
    "dependency_relation_kinds",
    "steps"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "source_revision": { "type": "string", "minLength": 1 },
    "system_graph_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "planner": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 }
      }
    },
    "dependency_relation_kinds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "graph_node", "depends_on", "recovery_point"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "graph_node": { "type": "string", "minLength": 1 },
          "depends_on": {
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          },
          "recovery_point": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
