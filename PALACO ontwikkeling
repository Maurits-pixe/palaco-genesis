use chrono::{DateTime, Utc};
use palaco_foundation::telemetry::{
    ClockDrift, NodeId, RawAlert, RawAlertLevel, RawSourceMode, RawTelemetrySnapshot, SnapshotId,
};

#[derive(Debug, Clone)]
pub struct BuildInfo {
    pub version: String,
    pub git_commit: String,
    pub build_timestamp: DateTime<Utc>,
    pub profile: String,
}

#[derive(Debug, Clone, PartialEq, Eq)]
pub enum StatusFlag {
    Unknown,
    Pending,
    Verified,
    Valid,
    Warning,
    Expired,
    Offline,
    Error,
}

#[derive(Debug, Clone)]
pub struct CryptoStatus {
    pub root_hash: StatusFlag,
    pub evidence_chain: StatusFlag,
    pub signature_status: StatusFlag,
    pub clock_drift: ClockDrift,
}

#[derive(Debug, Clone, PartialEq, Eq)]
pub enum AlertLevel {
    Info,
    Warning,
    Error,
}

#[derive(Debug, Clone)]
pub struct AlertEntry {
    pub level: AlertLevel,
    pub message: String,
    pub timestamp: DateTime<Utc>,
}

impl From<RawAlert> for AlertEntry {
    fn from(alert: RawAlert) -> Self {
        Self {
            level: match alert.level {
                RawAlertLevel::Info => AlertLevel::Info,
                RawAlertLevel::Warning => AlertLevel::Warning,
                RawAlertLevel::Error => AlertLevel::Error,
            },
            message: alert.message,
            timestamp: alert.timestamp,
        }
    }
}

#[derive(Debug, Clone, PartialEq, Eq)]
pub enum DataSource {
    Prototype,
    Simulation,
    Live,
}

#[derive(Debug, Clone)]
pub struct HealthScore {
    pub score: u8,
}

impl HealthScore {
    pub fn calculate(model: &ObservatoryModel) -> Self {
        let mut score = 100;

        if model.crypto.root_hash == StatusFlag::Error {
            score = score.saturating_sub(40);
        }

        if model.crypto.evidence_chain == StatusFlag::Error {
            score = score.saturating_sub(40);
        }

        if model.crypto.signature_status == StatusFlag::Error {
            score = score.saturating_sub(20);
        }

        Self { score }
    }
}

#[derive(Debug, Clone)]
pub struct RuntimeMetrics {
    pub active_alerts: usize,
    pub clock_drift_ms: u128,
    pub snapshot_age_ms: u128,
}

#[derive(Debug, Clone)]
pub struct ObservatoryModel {
    pub snapshot_id: SnapshotId,
    pub node_id: NodeId,
    pub snapshot_timestamp: DateTime<Utc>,
    pub build: BuildInfo,
    pub crypto: CryptoStatus,
    pub alerts: Vec<AlertEntry>,
    pub data_source: DataSource,
    pub health: HealthScore,
    pub runtime: RuntimeMetrics,
}

impl ObservatoryModel {
    pub fn from_raw(raw: RawTelemetrySnapshot, received_at: DateTime<Utc>) -> Self {
        let root_hash = match raw.root_hash_verified {
            Some(true) => StatusFlag::Verified,
            Some(false) => StatusFlag::Error,
            None => StatusFlag::Unknown,
        };

        let evidence_chain = match raw.evidence_chain_verified {
            Some(true) => StatusFlag::Verified,
            Some(false) => StatusFlag::Error,
            None => StatusFlag::Unknown,
        };

        let signature_status = match raw.signature_valid {
            Some(true) => StatusFlag::Valid,
            Some(false) => StatusFlag::Error,
            None => StatusFlag::Unknown,
        };

        let crypto = CryptoStatus {
            root_hash,
            evidence_chain,
            signature_status,
            clock_drift: raw.clock_drift,
        };

        let alerts: Vec<AlertEntry> = raw
            .active_alerts
            .into_iter()
            .map(AlertEntry::from)
            .collect();

        let data_source = match raw.source_mode {
            RawSourceMode::Prototype => DataSource::Prototype,
            RawSourceMode::Simulation => DataSource::Simulation,
            RawSourceMode::Live => DataSource::Live,
        };

        let active_alerts_count = alerts.len();
        let clock_drift_ms = raw.clock_drift.0.as_millis();
        let snapshot_age_ms = Utc::now()
            .signed_duration_since(raw.snapshot_timestamp)
            .num_milliseconds()
            .max(0) as u128;

        let runtime = RuntimeMetrics {
            active_alerts: active_alerts_count,
            clock_drift_ms,
            snapshot_age_ms,
        };

        let mut model = Self {
            snapshot_id: raw.snapshot_id,
            node_id: raw.node_id,
            snapshot_timestamp: raw.snapshot_timestamp,
            build: BuildInfo {
                version: raw.version,
                git_commit: raw.git_commit,
                build_timestamp: raw.build_timestamp,
                profile: raw.profile,
            },
            crypto,
            alerts,
            data_source,
            health: HealthScore { score: 100 },
            runtime,
        };

        model.health = HealthScore::calculate(&model);
        model
    }
}

