// palaco-observatory/src/service.rs

use std::sync::Arc;
use std::time::Duration;
use chrono::{DateTime, Utc};
use tokio::sync::RwLock;
use tokio_util::sync::CancellationToken;

use palaco_foundation::telemetry::{RawTelemetrySnapshot, TelemetryError, TelemetryProvider};

#[derive(Debug, Clone)]
pub struct CachedSnapshot {
    pub snapshot: RawTelemetrySnapshot,
    pub received_at: DateTime<Utc>,
}

pub struct TelemetryService {
    provider: Arc<dyn TelemetryProvider>,
    cache: Arc<RwLock<Option<CachedSnapshot>>>,
    cancel: CancellationToken,
    poll_interval: Duration,
}

impl TelemetryService {
    pub fn new(provider: Arc<dyn TelemetryProvider>, poll_interval: Duration) -> Self {
        Self {
            provider,
            cache: Arc::new(RwLock::new(None)),
            cancel: CancellationToken::new(),
            poll_interval,
        }
    }

    pub fn start_background_polling(&self) {
        let provider = Arc::clone(&self.provider);
        let cache = Arc::clone(&self.cache);
        let cancel = self.cancel.clone();
        let mut ticker = tokio::time::interval(self.poll_interval);

        tokio::spawn(async move {
            loop {
                tokio::select! {
                    _ = cancel.cancelled() => {
                        break;
                    }
                    _ = ticker.tick() => {
                        match provider.fetch_snapshot().await {
                            Ok(snapshot) => {
                                if let Err(e) = snapshot.validate() {
                                    tracing::warn!("Telemetry validation failed: {}", e);
                                    continue;
                                }

                                let mut guard = cache.write().await;
                                *guard = Some(CachedSnapshot {
                                    snapshot,
                                    received_at: Utc::now(),
                                });
                            }
                            Err(e) => {
                                tracing::warn!("Telemetry polling failed: {}", e);
                            }
                        }
                    }
                }
            }
        });
    }

    pub fn shutdown(&self) {
        self.cancel.cancel();
    }

    pub async fn get_latest_cached_snapshot(&self) -> Result<CachedSnapshot, TelemetryError> {
        let guard = self.cache.read().await;
        guard.clone().ok_or_else(|| TelemetryError::RuntimeUnavailable("No cached snapshot available".into()))
    }
}

