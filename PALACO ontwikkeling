        Ok(SandboxResult {
            proposal_id: proposal.id,
            safe_to_merge: safe,
            evaluated_risk_score: evaluated_risk,
            diagnostic_message: if safe {
                "Sandbox simulation passed successfully without invariant violations.".to_string()
            } else {
                "Sandbox simulation failed: evaluated risk score exceeds maximum threshold.".to_string()
            },
        })
    }
