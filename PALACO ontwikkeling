#[test]
fn event_is_stored_immutably()
{

    let mut store =
        ImmutableEventStore::new();


    let event =
        Event {
            id: EventId(
                uuid::Uuid::new_v4()
            ),

            created_at:
                chrono::Utc::now(),

            payload:
                vec![1,2,3],

            evidence:
                EvidenceHash(
                    [0u8;32]
                ),
        };


    assert!(
        store.publish(event)
        .is_ok()
    );


    assert_eq!(
        store.events().len(),
        1
    );
}


