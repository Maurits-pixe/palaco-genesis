use palaco_citadel::{
    CitadelEngine,
    Command,
    AuthorityToken,
    EvidenceBundle,
    ExecutionRequest,
    ExecutionReceipt,
    GovernancePolicy,
    ExecutionError,
};

pub struct PalacoRuntime {
    engine: CitadelEngine,
}

impl PalacoRuntime {
    pub fn new() -> Self {
        Self {
            engine: CitadelEngine::new(),
        }
    }

    pub fn boot(&self) -> Result<(), ExecutionError> {
        if !GovernancePolicy::verify_invariants() {
            return Err(ExecutionError::RuntimeBypassAttempted);
        }
        Ok(())
    }

    pub fn dispatch(
        &self,
        payload: String,
        target: String,
        token_id: String,
        issuer: String,
        signature: String,
        evidence_id: String,
        hash: String,
        timestamp: u64,
    ) -> Result<ExecutionReceipt, ExecutionError> {
        let request = ExecutionRequest {
            command: Command {
                payload,
                target_subsystem: target,
            },
            authority: AuthorityToken {
                token_id,
                issuer,
                signature,
            },
            evidence: EvidenceBundle {
                evidence_id,
                hash,
                timestamp,
            },
        };

        self.engine.process_execution(request)
    }
}

impl Default for PalacoRuntime {
    fn default() -> Self {
        Self::new()
    }
}

