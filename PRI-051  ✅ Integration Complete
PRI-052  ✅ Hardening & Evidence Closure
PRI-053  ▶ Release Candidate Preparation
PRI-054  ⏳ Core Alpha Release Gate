//! # palaco-foundation::tests
//!
//! Comprehensive unit, contract, and property-based test suites for the
//! `palaco-foundation` crate, ensuring cryptographic integrity and invariant enforcement.

#[cfg(test)]
mod foundation_tests {
    use crate::config::NodeConfig;
    use crate::error::ValidationError;
    use crate::model::{BaselineRecord, ProposalRecord};
    use crate::service::{RuntimeService, ServiceState};
    use crate::types::{BaselineId, ClockDrift, Hash256, NodeId, ProposalId};
    use crate::validation::{ValidationResult, Validator};

    #[test]
    fn test_node_config_default_and_validation() {
        let config = NodeConfig::default();
        assert_eq!(config.node_name, "palaco-node-primary");
        assert_eq!(config.max_clock_drift, ClockDrift(500));
        assert!(config.enforce_secure_enclaves);

        let service = RuntimeService::new(config);
        assert!(service.is_ok());

        let mut active_service = service.unwrap();
        assert_eq!(active_service.state(), ServiceState::Dormant);

        let boot_result = active_service.bootstrap();
        assert!(boot_result.is_ok());
        assert_eq!(active_service.state(), ServiceState::Operational);
    }

    #[test]
    fn test_invalid_config_empty_name() {
        let mut config = NodeConfig::default();
        config.node_name = "".to_string();

        let service = RuntimeService::new(config);
        assert!(matches!(service, Err(ValidationError::InvalidConfiguration(_))));
    }

    #[test]
    fn test_secure_enclave_lockdown() {
        let mut config = NodeConfig::default();
        config.enforce_secure_enclaves = false;

        let mut service = RuntimeService::new(config).unwrap();
        let boot_result = service.bootstrap();

        assert!(matches!(boot_result, Err(ValidationError::InvariantViolation(_))));
        assert_eq!(service.state(), ServiceState::Lockdown);
    }

    #[test]
    fn test_validators_zero_buffer_rejection() {
        let zero_hash = Hash256([0u8; 32]);
        let valid_hash = Hash256([1u8; 32]);

        assert!(Validator::validate_hash(&zero_hash).is_invalid());
        assert!(Validator::validate_hash(&valid_hash).is_valid());

        let zero_node = NodeId([0u8; 32]);
        let valid_node = NodeId([2u8; 32]);

        assert!(Validator::validate_node_id(&zero_node).is_invalid());
        assert!(Validator::validate_node_id(&valid_node).is_valid());
    }

    #[test]
    fn test_domain_models_serialization() {
        let baseline = BaselineRecord {
            id: BaselineId([1u8; 32]),
            evidence_root: Hash256([2u8; 32]),
            activated_at: 1785840000,
            certified_by: NodeId([3u8; 32]),
        };

        let serialized = serde_json::to_string(&baseline).expect("Failed to serialize baseline");
        let deserialized: BaselineRecord = serde_json::from_str(&serialized).expect("Failed to deserialize baseline");

        assert_eq!(baseline, deserialized);

        let proposal = ProposalRecord {
            id: ProposalId(42),
            target_subsystem: "palaco-kernel".to_string(),
            patch_hash: Hash256([9u8; 32]),
            risk_score: 12,
        };

        let prop_serialized = serde_json::to_string(&proposal).expect("Failed to serialize proposal");
        let prop_deserialized: ProposalRecord = serde_json::from_str(&prop_serialized).expect("Failed to deserialize proposal");

        assert_eq!(proposal, prop_deserialized);
    }
}

