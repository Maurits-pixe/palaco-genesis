    Critical,
}

#[derive(Debug, Clone)]
pub struct CitadelEvent {
    pub source_tower: String,
    pub event_type: String,
    pub payload_digest: String,
    pub severity: EventSeverity,
}

pub struct HarborAdmissionGate;

impl ConstitutionalGate for HarborAdmissionGate {
    type Request = CitadelEvent;
    type Decision = bool;

    fn validate(
        &self,
        request: &Self::Request,
    ) -> Result<Self::Decision, ConstitutionalError> {
        // Harbor Admission Regel: Kritieke of lege payloads worden geweigerd of in quarantaine geplaatst
        if request.payload_digest.is_empty() {
            return Err(ConstitutionalError::InvariantViolation);
        }

        // Toelating op basis van geldige bron
        if request.source_tower.is_empty() {
            return Err(ConstitutionalError::Unauthorized);
        }

        Ok(true)
    }
}

pub struct EventBus {
    admission_gate: HarborAdmissionGate,
    stream: Vec<CitadelEvent>,
}

impl Default for EventBus {
    fn default() -> Self {
        Self {
            admission_gate: HarborAdmissionGate,
            stream: Vec::new(),
        }
    }
}

impl EventBus {
    pub fn new() -> Self {
        Self::default()
    }

    /// Publiceert een event nadat de Harbor de admissie heeft goedgekeurd
    pub fn publish(
        &mut self,
        _context: &ConstitutionalContext,
        event: CitadelEvent,
    ) -> Result<(), ConstitutionalError> {
        // GOVERNANCE PRECEDES EXECUTION / ADMISSION
        let decision = self.admission_gate.validate(&event)?;

        if decision {
            self.stream.push(event);
            Ok(())
        } else {
            Err(ConstitutionalError::InvariantViolation)
        }
    }

    pub fn stream(&self) -> &[CitadelEvent] {
        &self.stream
    }
}

