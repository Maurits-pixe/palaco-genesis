                .unwrap_or(0)), // Veilig: unwrap vervangen door default
            node_id: context.node_id.clone(),
            timestamp: context.timestamp,
            content_digest: content_hash,
        };

        self.history.push(record.clone());
        record
    }

    pub fn history(&self) -> &[ProvenanceRecord] {
        &self.history
    }
}

