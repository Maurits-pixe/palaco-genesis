    type Request = ExecutionPayload;
    type Decision = bool;

    fn validate(
        &self,
        request: &Self::Request,
    ) -> Result<Self::Decision, ConstitutionalError> {
        // Fijnmazige inspectie: maximale cycles mogen de grens niet overschrijden
        // en de bytecode digest moet aanwezig zijn.
        if request.bytecode_digest.is_empty() {
            return Err(ConstitutionalError::CorruptedProvenance);
        }

        if request.max_instruction_cycles == 0 || request.max_instruction_cycles > 1_000_000 {
            return Err(ConstitutionalError::InvariantViolation);
        }

        Ok(true)
    }
}

pub struct CitadelSandbox {
    state: SandboxState,
    gate: CitadelExecutionGate,
}

impl Default for CitadelSandbox {
    fn default() -> Self {
        Self {
            state: SandboxState::Idle,
            gate: CitadelExecutionGate,
        }
    }
}

impl CitadelSandbox {
    pub fn new() -> Self {
        Self::default()
    }

    /// Voert een taak uit binnen de Citadel mits goedgekeurd door de Gate en gekoppeld aan Quay
    pub fn execute(
        &mut self,
        _context: &ConstitutionalContext,
        _provenance: &ProvenanceRecord,
        payload: ExecutionPayload,
    ) -> Result<String, ConstitutionalError> {
        // GOVERNANCE PRECEDES EXECUTION
        let decision = self.gate.validate(&payload)?;

        if decision {
            self.state = SandboxState::Executing;
            // Simulatie van veilige, geïsoleerde runtime-executie
            let result_receipt = format!("EXEC_SUCCESS:{}", payload.task_id);
            self.state = SandboxState::Terminated;
            Ok(result_receipt)
        } else {
            self.state = SandboxState::Contained;
            Err(ConstitutionalError::InvariantViolation)
        }
    }

    pub fn state(&self) -> &SandboxState {
        &self.state
    }
}

#[cfg(test)]
mod tests {
    use super::*;

    #[test]
    fn test_citadel_sandbox_secure_execution() {
        let mut sandbox = CitadelSandbox::new();
        let context = ConstitutionalContext::new("node-citadel-01", 1781568447);
        let provenance = ProvenanceRecord {
            snapshot_id: "snap-p-boot-002".to_string(),
            node_id: context.node_id.clone(),
            timestamp: context.timestamp,
            content_digest: "67da873b25715ac5823ab9143dd3ed7598005743".to_string(),
        };

        // Geldige payload
        let valid_payload = ExecutionPayload {
            task_id: "task-alpha-01".to_string(),
            bytecode_digest: "sha256:deadbeef".to_string(),
            max_instruction_cycles: 5000,
        };

        let result = sandbox.execute(&context, &provenance, valid_payload);
        assert!(result.is_ok());
        assert_eq!(result.unwrap(), "EXEC_SUCCESS:task-alpha-01");
        assert_eq!(*sandbox.state(), SandboxState::Terminated);

        // Ongeldige payload (te veel cycles)
        let mut corrupted_sandbox = CitadelSandbox::new();
        let invalid_payload = ExecutionPayload {
            task_id: "task-beta-02".to_string(),
            bytecode_digest: "sha256:deadbeef".to_string(),
            max_instruction_cycles: 9_999_999,
        };

        let fail_result = corrupted_sandbox.execute(&context, &provenance, invalid_payload);
        assert_eq!(fail_result, Err(ConstitutionalError::InvariantViolation));
        assert_eq!(*corrupted_sandbox.state(), SandboxState::Contained);
    }
}

