7. Append-Only Store

Eerste minimale implementatie:

use crate::{
    Event,
    EventError,
};


pub struct ImmutableEventStore {

    events: Vec<Event>,
}


impl ImmutableEventStore {

    pub fn new()
        -> Self {

        Self {
            events: Vec::new()
        }
    }


    pub fn events(
        &self
    ) -> &[Event] {

        &self.events
    }
}


impl EventPublisher
for ImmutableEventStore {

    fn publish(
        &mut self,
        event: Event
    )
    -> Result<(), EventError> {

        self.events.push(event);

        Ok(())
    }
}


