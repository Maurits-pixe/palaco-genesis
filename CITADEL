/// Immutable execution receipt recorded in the cryptographic hash chain.
#[derive(Debug, Clone, Serialize, Deserialize)]
pub struct ExecutionReceipt {
    pub timestamp: DateTime<Utc>,
    pub event_id: String,
    pub module: String,
    pub node_id: String,
    pub hash: String,
    pub parent_hash: String,
    pub verified: bool,
    pub committed: bool,
}

impl fmt::Display for ExecutionReceipt {
    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
        write!(
            f,
            "[{}] Event {} Module {} Node {} Hash {} Parent {} Receipt {} Status {}",
            self.timestamp.format("%H:%M:%S"),
            self.event_id,
            self.module,
            self.node_id,
            self.hash,
            self.parent_hash,
            if self.verified { "VERIFIED" } else { "FAILED" },
            if self.committed { "COMMITTED" } else { "PENDING" }
        )
    }
}

