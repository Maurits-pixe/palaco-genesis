# Required: supply a strong 32-4096 character printable ASCII token, no whitespace,
# and a 32-byte key as 64 hex characters.
# Export these variables in your shell; the service does not load dotenv files.
# Unix database files are restricted to 0600; also use umask 077 when launching.
AETHER_TOKEN=
AETHER_KEY_HEX=
AETHER_PORT=8787
AETHER_DB=aether.db
